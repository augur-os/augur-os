{
  "_comment": "Copy this to mcp.json. Replace /path/to/augur-os with your install path.",
  "mcpServers": {
    "augur-core": {
      "command": "python",
      "args": ["-m", "augur_core", "--client-id", "claude"],
      "cwd": "/path/to/augur-os",
      "env": {
        "AUGUR_ROOT": "/path/to/augur-os",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/path/to/augur-os/project-brain:/path/to/augur-os:/path/to/augur-os/src/mcp"
      }
    }
  }
}
