{
  "name": "augur",
  "displayName": "Augur",
  "description": "Connect Augur — your local-first AI second brain. Install, configure, and monitor Augur from VS Code.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "augur.status",
        "title": "Augur: Check Status"
      },
      {
        "command": "augur.install",
        "title": "Augur: Install"
      },
      {
        "command": "augur.configure",
        "title": "Augur: Configure MCP"
      },
      {
        "command": "augur.openDashboard",
        "title": "Augur: Open Dashboard"
      },
      {
        "command": "augur.sync",
        "title": "Augur: Sync Now"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "augur",
          "title": "Augur",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "augur": [
        {
          "id": "augur.status",
          "name": "Status",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
