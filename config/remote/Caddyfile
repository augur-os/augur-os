# Augur Remote Access — Caddy Reverse Proxy
# Usage: caddy run --config config/remote/Caddyfile
#
# Replace {$AUGUR_HOST} with your LAN IP or hostname, e.g.:
#   AUGUR_HOST=192.168.1.100 caddy run --config config/remote/Caddyfile

{$AUGUR_HOST:localhost} {
	# TLS with internal CA (self-signed, trust via `caddy trust`)
	tls internal

	# MCP server — strip /mcp prefix, proxy to Python MCP server
	handle_path /mcp/* {
		reverse_proxy localhost:8000 {
			# SSE streaming support
			flush_interval -1
		}
	}

	# Dashboard SSE streams (CLI, events)
	handle /api/cli* {
		reverse_proxy localhost:3000 {
			flush_interval -1
		}
	}

	# All other requests → Next.js dashboard
	handle {
		reverse_proxy localhost:3000
	}
}
