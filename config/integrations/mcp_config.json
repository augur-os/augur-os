{
  "mcpServers": {
    "augur": {
      "command": "bash",
      "args": [
        "-lc",
        "cd \"${AUGUR_ROOT:-$PWD}\" && exec ./scripts/augur-mcp --client-id antigravity"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "context7": {
      "command": "bash",
      "args": [
        "-lc",
        "npx -y @upstash/context7-mcp"
      ]
    }
  }
}
