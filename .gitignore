# Archives
*.zip
*.tar
*.gz
*.rar
*.7z
# ADR archive bundles must be tracked (ADR-608 — required by /adr extract and the
# augur-os public release pipeline). Keep this exception below the *.zip rule.
# Includes the orphan-specs-plans bundle alongside ADR bundles — single archive
# folder, single index (adrs-index.json).
!docs/adrs/archive/*.zip
# loop-hygiene golden fixtures: fake binaries (plain ASCII, <100B each)
# named with binary extensions to exercise the scanner's pattern detection.
# Keep this exception below the binary-extension rules.
!project-brain/capabilities/skills/loop-hygiene/evals/fixtures/**/*.png
!project-brain/capabilities/skills/loop-hygiene/evals/fixtures/**/*.svg
!project-brain/capabilities/skills/loop-hygiene/evals/fixtures/**/*.zip
!project-brain/capabilities/skills/loop-hygiene/evals/fixtures/**/*.pdf
!project-brain/capabilities/skills/loop-hygiene/evals/fixtures/**/*.pptx
*.dmg
*.iso
# Fonts
*.woff
*.woff2
*.ttf
*.eot
*.otf
# Design
*.sketch
*.fig

# All assets directories are local-only; keep contents out of git index
**/assets/**
!plugins/**/assets/
!plugins/**/assets/seed-data/
!plugins/**/assets/seed-data/**
!plugins/**/assets/seed-data/prompts/
!plugins/**/assets/seed-data/prompts/**
# Skills seed data must be tracked for portable skills pack (build_skills_pack.py)
# Must un-ignore parent dir first (git requires this), then re-ignore non-seed content
!skills/**/assets/
skills/**/assets/*
!skills/**/assets/seeds/
!skills/**/assets/seeds/**
!skills/**/assets/templates/
!skills/**/assets/templates/**
# Post-ADR-601 project-brain layout — mirror the rules so seed/template
# assets under project-brain/capabilities/skills/**/assets/ stay tracked.
!project-brain/capabilities/skills/**/assets/
project-brain/capabilities/skills/**/assets/*
!project-brain/capabilities/skills/**/assets/seeds/
!project-brain/capabilities/skills/**/assets/seeds/**
!project-brain/capabilities/skills/**/assets/templates/
!project-brain/capabilities/skills/**/assets/templates/**
# But never commit macOS Finder metadata, even under the unignored seed/template paths
project-brain/capabilities/skills/**/.DS_Store

# Forbidden: augur/data/ — user-editable content lives in ~/Vault/Augur (ADR-270)
plugins/**/augur/data/

# User Customizations (ADR-048: Multi-User Scale Support)
# Custom plugins and data are user-owned, never committed to upstream
plugins/custom/skills/

# Root pollution guard — these dirs must live under state/
/factory/
/security/

# Memory daily logs (ephemeral, 14-day retention)
docs/memory/daily/

# User-specific config (not committed)
config/preferences.yaml
config/system/preferences.yaml
config/system/plugin_state.json
# Per-skill config files (ADR-129 — user-local state)
plugins/**/.config
.mypy_cache/
*.lock.txt

