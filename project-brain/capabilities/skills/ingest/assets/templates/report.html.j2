<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ report.title }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: #0f172a;
    color: #e2e8f0;
    line-height: 1.6;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .report {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 0 60px 0;
  }

  /* ── Cover ─────────────────────────────────────────────── */
  .cover {
    background: linear-gradient(135deg, #6366f1 0%, #3b82f6 50%, #06b6d4 100%);
    padding: 60px 48px 48px;
    position: relative;
    overflow: hidden;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 80%, rgba(99,102,241,0.4) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(6,182,212,0.3) 0%, transparent 50%);
    pointer-events: none;
  }

  .cover-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 32px;
  }

  .cover-photo {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.5);
    object-fit: cover;
    background: rgba(255,255,255,0.1);
  }

  .cover-photo-placeholder {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    color: rgba(255,255,255,0.7);
  }

  .cover-text { flex: 1; }

  .cover-tag {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    margin-bottom: 16px;
  }

  .cover h1 {
    font-size: 36px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .cover-meta {
    font-size: 15px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 28px;
  }

  .cover-meta strong {
    color: #ffffff;
    font-weight: 600;
  }

  .synthesis-box {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 12px;
    padding: 20px 24px;
    font-size: 15px;
    color: rgba(255,255,255,0.92);
    line-height: 1.7;
    font-style: italic;
  }

  /* Stat bar */
  .stat-bar {
    display: flex;
    gap: 0;
    background: #1e293b;
    border-top: none;
  }

  .stat-item {
    flex: 1;
    padding: 20px 16px;
    text-align: center;
    border-right: 1px solid #334155;
  }

  .stat-item:last-child { border-right: none; }

  .stat-value {
    font-size: 26px;
    font-weight: 800;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  /* ── Section wrapper ────────────────────────────────────── */
  .section {
    padding: 48px 48px 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .section-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .section-icon.purple { background: rgba(99,102,241,0.2); }
  .section-icon.blue   { background: rgba(59,130,246,0.2); }
  .section-icon.green  { background: rgba(34,197,94,0.2); }

  .section-title {
    font-size: 22px;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: 13px;
    color: #64748b;
    margin-top: 2px;
  }

  .divider {
    height: 1px;
    background: #1e293b;
    margin: 0 48px;
  }

  /* ── Cards ──────────────────────────────────────────────── */
  .card {
    background: #1e293b;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid #334155;
  }

  .card-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #64748b;
    margin-bottom: 12px;
  }

  .card-body {
    font-size: 14px;
    color: #cbd5e1;
    line-height: 1.75;
  }

  /* ── Who You Are ────────────────────────────────────────── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .narrative-stack { display: flex; flex-direction: column; gap: 16px; }

  /* Expertise bars */
  .expertise-bar-row {
    margin-bottom: 14px;
  }

  .expertise-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }

  .expertise-domain {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
  }

  .expertise-level {
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .bar-track {
    height: 8px;
    background: #334155;
    border-radius: 4px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  /* ── Hub cards ──────────────────────────────────────────── */
  .hub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  .hub-card {
    background: #1e293b;
    border-radius: 12px;
    border: 1px solid #334155;
    border-left-width: 4px;
    padding: 20px;
  }

  .hub-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .hub-icon {
    font-size: 20px;
    line-height: 1;
  }

  .hub-name {
    font-size: 15px;
    font-weight: 700;
    color: #e2e8f0;
    flex: 1;
  }

  .hub-count {
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hub-summary {
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.65;
  }

  /* ── Chart images ───────────────────────────────────────── */
  .chart-row {
    display: grid;
    gap: 20px;
    margin-top: 8px;
  }

  .chart-row.two { grid-template-columns: 1fr 1fr; }
  .chart-row.one { grid-template-columns: 1fr; }

  .chart-box {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    overflow: hidden;
  }

  .chart-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #64748b;
    padding: 14px 18px 8px;
  }

  .chart-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Patterns & Blind Spots ─────────────────────────────── */
  .pattern-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-left: 3px solid #22c55e;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 12px;
  }

  .pattern-title {
    font-size: 14px;
    font-weight: 700;
    color: #e2e8f0;
    margin-bottom: 6px;
  }

  .pattern-desc {
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.65;
  }

  .blind-spot-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 12px;
  }

  .blind-spot-card.low { border-left: 3px solid #22c55e; }
  .blind-spot-card.medium { border-left: 3px solid #f59e0b; }
  .blind-spot-card.high { border-left: 3px solid #ef4444; }

  .blind-spot-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .severity-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .severity-dot.low { background: #22c55e; }
  .severity-dot.medium { background: #f59e0b; }
  .severity-dot.high { background: #ef4444; }

  .blind-spot-title {
    font-size: 14px;
    font-weight: 700;
    color: #e2e8f0;
  }

  .blind-spot-desc {
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.65;
  }

  .col-title {
    font-size: 15px;
    font-weight: 700;
    color: #e2e8f0;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #334155;
  }

  /* ── Footer ─────────────────────────────────────────────── */
  .footer {
    margin-top: 48px;
    padding: 32px 48px;
    border-top: 1px solid #1e293b;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .footer-quote {
    font-size: 13px;
    color: #475569;
    font-style: italic;
    max-width: 480px;
    line-height: 1.6;
  }

  .footer-quote cite {
    display: block;
    margin-top: 6px;
    font-style: normal;
    font-size: 11px;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .footer-brand {
    text-align: right;
    flex-shrink: 0;
  }

  .footer-brand-name {
    font-size: 14px;
    font-weight: 800;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.01em;
  }

  .footer-brand-tagline {
    font-size: 11px;
    color: #475569;
    margin-top: 3px;
  }

  .footer-url {
    font-size: 11px;
    color: #334155;
    margin-top: 2px;
    font-weight: 600;
  }

  /* ── Print ──────────────────────────────────────────────── */
  @media print {
    body { background: #0f172a; }
    .report { max-width: 100%; }
    .cover { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>
<div class="report">

  <!-- ══════════════════════════════════════════════════════════
       SECTION 1: COVER
  ═══════════════════════════════════════════════════════════ -->
  <div class="cover">
    <div class="cover-inner">
      {% if report.portfolio and report.portfolio.profile %}
        <img class="cover-photo" src="{{ report.portfolio.profile }}" alt="{{ report.name }}">
      {% else %}
        <div class="cover-photo-placeholder">&#9679;</div>
      {% endif %}

      <div class="cover-text">
        <div class="cover-tag">Second Brain Intelligence Report</div>
        <h1>{{ report.title }}</h1>
        <div class="cover-meta">
          Prepared for <strong>{{ report.name }}</strong> &nbsp;&middot;&nbsp; {{ report.date }}
        </div>

        {% if report.synthesis %}
        <div class="synthesis-box">
          {{ report.synthesis }}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="stat-bar">
    <div class="stat-item">
      <div class="stat-value">{{ report.stats.pages }}</div>
      <div class="stat-label">Wiki Pages</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{ report.stats.hubs }}</div>
      <div class="stat-label">Hubs</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{ report.stats.sources }}</div>
      <div class="stat-label">Sources</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{ report.stats.words }}</div>
      <div class="stat-label">Words</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{ report.stats.cross_refs }}</div>
      <div class="stat-label">Cross-Refs</div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 2: WHO YOU ARE
  ═══════════════════════════════════════════════════════════ -->
  <div class="section" style="padding-top: 48px;">
    <div class="section-header">
      <div class="section-icon purple">&#128100;</div>
      <div>
        <div class="section-title">Who You Are</div>
        <div class="section-subtitle">Identity synthesis from your knowledge graph</div>
      </div>
    </div>

    <div class="two-col">
      <!-- Left: narrative cards -->
      <div class="narrative-stack">
        {% if report.who_you_are and report.who_you_are.what_you_do %}
        <div class="card">
          <div class="card-title">What You Do</div>
          <div class="card-body">{{ report.who_you_are.what_you_do }}</div>
        </div>
        {% endif %}

        {% if report.who_you_are and report.who_you_are.how_you_think %}
        <div class="card">
          <div class="card-title">How You Think</div>
          <div class="card-body">{{ report.who_you_are.how_you_think }}</div>
        </div>
        {% endif %}
      </div>

      <!-- Right: expertise stack -->
      {% if report.expertise %}
      <div class="card">
        <div class="card-title">Expertise Stack</div>
        {% for item in report.expertise %}
        <div class="expertise-bar-row">
          <div class="expertise-bar-header">
            <span class="expertise-domain">{{ item.domain }}</span>
            <span class="expertise-level">{{ item.level }}</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill" style="width: {{ item.percentage }}%; background: {{ item.color }};"></div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

  <div class="divider" style="margin-top: 48px;"></div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 3: WHAT YOUR BRAIN CONTAINS
  ═══════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <div class="section-icon blue">&#129504;</div>
      <div>
        <div class="section-title">What Your Brain Contains</div>
        <div class="section-subtitle">Knowledge organized across {{ report.stats.hubs }} hubs from {{ report.stats.sources }} sources</div>
      </div>
    </div>

    <div class="hub-grid">
      {% for hub in report.hub_sections %}
      <div class="hub-card" style="border-left-color: {{ hub.color }};">
        <div class="hub-header">
          {% if hub.icon %}
          <span class="hub-icon">{{ hub.icon }}</span>
          {% endif %}
          <span class="hub-name">{{ hub.name }}</span>
          <span class="hub-count">{{ hub.source_count }} sources</span>
        </div>
        <div class="hub-summary">{{ hub.summary }}</div>
      </div>
      {% endfor %}
    </div>

    {% if report.charts.radar or report.charts.distribution %}
    <div class="chart-row {% if report.charts.radar and report.charts.distribution %}two{% else %}one{% endif %}">
      {% if report.charts.radar %}
      <div class="chart-box">
        <div class="chart-label">Knowledge Radar</div>
        <img class="chart-img" src="{{ report.charts.radar }}" alt="Knowledge radar chart">
      </div>
      {% endif %}
      {% if report.charts.distribution %}
      <div class="chart-box">
        <div class="chart-label">Hub Distribution</div>
        <img class="chart-img" src="{{ report.charts.distribution }}" alt="Hub distribution chart">
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>

  <div class="divider" style="margin-top: 48px;"></div>

  <!-- ══════════════════════════════════════════════════════════
       SECTION 4: PATTERNS & BLIND SPOTS
  ═══════════════════════════════════════════════════════════ -->
  {% if report.patterns or report.blind_spots %}
  <div class="section">
    <div class="section-header">
      <div class="section-icon green">&#128269;</div>
      <div>
        <div class="section-title">Patterns &amp; Blind Spots</div>
        <div class="section-subtitle">What your AI noticed — and what's missing</div>
      </div>
    </div>

    <div class="two-col">
      <!-- Patterns -->
      {% if report.patterns %}
      <div>
        <div class="col-title">Patterns Your AI Noticed</div>
        {% for pattern in report.patterns %}
        <div class="pattern-card">
          <div class="pattern-title">{{ pattern.title }}</div>
          <div class="pattern-desc">{{ pattern.description }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Blind Spots -->
      {% if report.blind_spots %}
      <div>
        <div class="col-title">Blind Spots &amp; Gaps</div>
        {% for spot in report.blind_spots %}
        <div class="blind-spot-card {{ spot.severity }}">
          <div class="blind-spot-header">
            <div class="severity-dot {{ spot.severity }}"></div>
            <div class="blind-spot-title">{{ spot.title }}</div>
          </div>
          <div class="blind-spot-desc">{{ spot.description }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if report.charts.graph %}
    <div class="chart-row one" style="margin-top: 28px;">
      <div class="chart-box">
        <div class="chart-label">Knowledge Graph</div>
        <img class="chart-img" src="{{ report.charts.graph }}" alt="Knowledge graph">
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       FOOTER
  ═══════════════════════════════════════════════════════════ -->
  <div class="footer">
    <div class="footer-quote">
      "The best way to use your second brain is to let it surface what you can't keep in your head — then act on it."
      <cite>— Inspired by Andrej Karpathy</cite>
    </div>
    <div class="footer-brand">
      <div class="footer-brand-name">Augur</div>
      <div class="footer-brand-tagline">your second brain, on your machine</div>
      <div class="footer-url">augur.run</div>
    </div>
  </div>

</div>
</body>
</html>
