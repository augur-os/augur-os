# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next
/.next/
/out/
/.swc
/.mypy_cache

# production
/build

# misc
.DS_Store
*.pem

# plugin mounting temp directory (prevents Tailwind race condition)
/.plugin-staging/
/.materialize.lock

# compiled build scripts (generated by build-scripts.mjs)
/scripts/dist/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug_output.txt

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated tab registry (auto-generated by generate-tab-registry.ts)
/lib/tabs/generated-registry.ts

# Generated Browse item-action registry (auto-generated by generate-item-actions.ts)
/lib/browse/generated-item-actions.ts

# Generated hub assembly snapshot (auto-generated by mount-plugins.ts)
/lib/plugin-runtime/assembled-hubs.json

# Generated custom block registry (auto-generated by generate-tab-registry.ts)
/lib/blocks/custom-block-registry.ts
/lib/blocks/generated-block-registry.ts

# Generated config page wrappers and dashboard-local skill page copies
/lib/configs/
/features/generated-skill-pages/
/lib/tabs/generated-skill-nav.ts

# Mounted plugin UI routes (auto-generated by mount-plugins.ts)
# Hub-based routing: /{hub}/{skill}/ — each hub directory contains mounted skill subdirs
# Hub layouts and landing pages (layout.tsx, page.tsx) are also auto-generated
/app/adaptive/
/app/brain/
/app/business/
/app/career/
/app/command/
/app/dev/
/app/hidden/
/app/life/
/app/studio/
/app/websites/

# Mounted plugin API routes (auto-generated by mount-plugins.ts)
/app/api/adaptive/
/app/api/brain/
/app/api/career/
/app/api/command/
/app/api/hidden/
/app/api/life/
/app/api/studio/
