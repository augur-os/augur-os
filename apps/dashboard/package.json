{
  "name": "dashboard",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:scripts": "node scripts/build-scripts.mjs",
    "postinstall": "node -e \"const fs=require('fs');const os=require('os');const path=require('path');if(os.platform()!=='darwin')process.exit(0);const prebuilds=path.join(process.cwd(),'node_modules','node-pty','prebuilds');if(!fs.existsSync(prebuilds))process.exit(0);for(const dir of fs.readdirSync(prebuilds)){if(!dir.startsWith('darwin-'))continue;const helper=path.join(prebuilds,dir,'spawn-helper');if(!fs.existsSync(helper))continue;try{fs.chmodSync(helper,0o755);}catch{}}\"",
    "prepare": "pnpm run build:scripts",
    "generate-item-actions": "node scripts/dist/generate-item-actions.mjs",
    "ensure-generated": "pnpm run build:scripts && pnpm run generate-item-actions && pnpm run rebuild-plugins",
    "predev": "pnpm run build:scripts && pnpm run generate-item-actions",
    "dev": "node scripts/start-dev.mjs",
    "prod": "node scripts/build.mjs && node scripts/start-dev.mjs --prod",
    "build": "node scripts/build.mjs",
    "build:safe": "node scripts/build-lock.mjs pnpm run build",
    "prebuild": "pnpm run ensure-generated",
    "pretypecheck": "pnpm run ensure-generated",
    "start": "next start",
    "lint": "eslint . --ignore-pattern scripts/dist",
    "typecheck": "tsc --noEmit",
    "setup-mcp": "node scripts/dist/setup-mcp.mjs",
    "generate-registry": "uv run python scripts/generate_registry.py",
    "check-registry": "uv run python scripts/generate_registry.py --check",
    "mount-plugins": "node scripts/dist/mount-plugins.mjs",
    "mount-plugins:clean": "node scripts/dist/mount-plugins.mjs --clean",
    "mount-plugins:watch": "node scripts/dist/mount-plugins.mjs --watch",
    "generate-tabs": "node scripts/dist/generate-tab-registry.mjs",
    "validate-nav": "node scripts/dist/validate-nav-alignment.mjs",
    "validate-tabs": "node scripts/dist/validate-nav-alignment.mjs",
    "validate:no-legacy-pages": "node scripts/dist/validate-no-legacy-pages.mjs --base origin/main --changed",
    "debug-yaml": "node scripts/dist/debug-yaml.mjs",
    "rebuild-plugins": "node scripts/dist/rebuild-plugins.mjs",
    "ui:scaffold": "node scripts/dist/ui/scaffold.mjs",
    "pretest": "pnpm run ensure-generated",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.1",
    "framer-motion": "^12.29.2",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.560.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.6",
    "next": "^16.2.6",
    "node-pty": "^1.1.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "recharts": "^2.15.4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "flatted": ">=3.4.2",
      "dompurify": ">=3.4.1",
      "picomatch": ">=4.0.4",
      "minimatch@3.1.5>brace-expansion": "1.1.13",
      "minimatch@10.2.5>brace-expansion": "5.0.6",
      "yaml": ">=2.8.3",
      "postcss": ">=8.5.10",
      "ws": ">=8.20.1",
      "esbuild": "0.28.1"
    }
  }
}
