#!/bin/bash
# Augur MCP server launcher
# Usage: augur-mcp [args]

set -euo pipefail

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "$(basename "$THIS_DIR")" == "scripts" ]]; then
    PROJECT_ROOT="$(dirname "$THIS_DIR")"
else
    PROJECT_ROOT="$THIS_DIR"
fi

PREFLIGHT_JSON="$(python3 "$PROJECT_ROOT/scripts/worktree_preflight.py" --root "$PROJECT_ROOT" --profile mcp --repair)"
PROJECT_ROOT="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["project_root"])')"
VENV_PYTHON="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["python_path"])')"

if [[ ! -x "$VENV_PYTHON" ]]; then
    echo "Error: Python venv not found at ${VENV_PYTHON}. Create it before running augur-mcp." >&2
    exit 1
fi

export AUGUR_ROOT="$PROJECT_ROOT"
export AUGUR_STATE="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["runtime_dir"])')"
export AUGUR_RUNTIME="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["runtime_dir"])')"
export MCP_PORT="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["mcp_port"])')"
export AUGUR_MCP_CLIENT_ID="$(printf '%s' "$PREFLIGHT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["mcp_client_id"])')"

if [[ -n "${PYTHONPATH:-}" ]]; then
    export PYTHONPATH="${PROJECT_ROOT}/src/mcp:${PROJECT_ROOT}:${PYTHONPATH}"
else
    export PYTHONPATH="${PROJECT_ROOT}/src/mcp:${PROJECT_ROOT}"
fi

exec "${VENV_PYTHON}" -m src.mcp.augur_framework "$@"
