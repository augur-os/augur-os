#!/bin/sh
# Worktree-aware Augur MCP launcher for Codex.

set -eu

script_dir="$(CDPATH= cd "$(dirname "$0")" && pwd -P)"
configured_root="$(CDPATH= cd "$script_dir/.." && pwd -P)"
cwd_root="$(pwd -P)"

root=""
for candidate in "${AUGUR_PROJECT_ROOT:-}" "${AUGUR_ROOT:-}" "${AUGUR_REPO:-}" "$configured_root" "$cwd_root"; do
    if [ -n "$candidate" ] && [ -f "$candidate/project.yaml" ]; then
        root="$(CDPATH= cd "$candidate" && pwd -P)"
        break
    fi
done

if [ -z "$root" ]; then
    echo "[augur] Codex MCP could not locate an Augur checkout. checked AUGUR_PROJECT_ROOT=${AUGUR_PROJECT_ROOT:-} AUGUR_ROOT=${AUGUR_ROOT:-} AUGUR_REPO=${AUGUR_REPO:-} configured=$configured_root cwd=$cwd_root" >&2
    exit 1
fi

py="$root/.venv/bin/python"
if [ ! -x "$py" ]; then
    py="$root/.venv/bin/python3"
fi
if [ ! -x "$py" ]; then
    py="python3"
fi

export AUGUR_ROOT="$root"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
project_capabilities="$root/project-brain/capabilities"
canonical_pythonpath="$project_capabilities:$root:$root/src/mcp"
if [ -n "${PYTHONPATH:-}" ]; then
    filtered_pythonpath=""
    old_ifs="$IFS"
    IFS=":"
    for entry in $PYTHONPATH; do
        IFS="$old_ifs"
        case "$entry" in
            ""|"$root"|"$project_capabilities"|"$root/src/mcp"|*/src/mcp|*/project-brain/capabilities|*/shared-vault|*/Augur)
                ;;
            *)
                if [ -z "$filtered_pythonpath" ]; then
                    filtered_pythonpath="$entry"
                else
                    filtered_pythonpath="$filtered_pythonpath:$entry"
                fi
                ;;
        esac
        IFS=":"
    done
    IFS="$old_ifs"
    if [ -n "$filtered_pythonpath" ]; then
        export PYTHONPATH="$canonical_pythonpath:$filtered_pythonpath"
    else
        export PYTHONPATH="$canonical_pythonpath"
    fi
else
    export PYTHONPATH="$canonical_pythonpath"
fi

exec "$py" "$@"
