#!/bin/sh
# ===========================================================================
# HARD RULE: pushes to the public augur-os mirror must contain only the exact
# architecture-doc public release tree.
#
# augur-os/augur-os is the PUBLIC release mirror. Development code (apps/,
# src/, project-brain/, tests/, ADRs, security docs, generated caches) must
# never be pushed there. This hook validates the exact commit tree being pushed
# before GitHub sees it.
# ===========================================================================

remote_name="$1"
remote_url="$2"
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
updates_file="$(mktemp "${TMPDIR:-/tmp}/augur-pre-push.XXXXXX")"
trap 'rm -f "$updates_file"' EXIT

cat > "$updates_file"

PYTHON_BIN="${PYTHON:-}"
if [ -z "$PYTHON_BIN" ]; then
  for candidate in "$root/.venv/bin/python" "$root/.venv/bin/python3" "$root/.venv/Scripts/python.exe" python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PYTHON_BIN="$candidate"
      break
    fi
  done
fi

if ! "$PYTHON_BIN" "$root/scripts/guard_public_push.py" \
  --remote-name "$remote_name" \
  --remote-url "$remote_url" \
  --repo "$root" \
  --source-root "$root" < "$updates_file"; then
  exit 1
fi

# --- Git LFS pre-push (preserved) ---
command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."
  exit 2
}
git lfs pre-push "$@" < "$updates_file"
