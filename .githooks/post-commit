#!/bin/sh
# Augur: incrementally refresh the RAG browse index for structural files changed
# in this commit. Runs before git-lfs so a missing git-lfs binary can't skip it;
# the helper backgrounds its own work and never blocks or fails the commit.
hook_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$hook_root" ] && [ -x "$hook_root/scripts/hooks/post-commit-index" ]; then
  "$hook_root/scripts/hooks/post-commit-index" || true
fi

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-commit' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-commit "$@"
