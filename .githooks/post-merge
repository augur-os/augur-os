#!/bin/sh
# Augur: refresh the RAG browse index for structural files brought in by a
# pull/merge (the cross-machine sync vector). Reuses the post-commit reindexer
# over the whole merged range (ORIG_HEAD..HEAD). Non-blocking; never fails.
hook_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$hook_root" ] && [ -x "$hook_root/scripts/hooks/post-commit-index" ]; then
  AUGUR_REINDEX_BASE=ORIG_HEAD "$hook_root/scripts/hooks/post-commit-index" || true
fi

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-merge "$@"
