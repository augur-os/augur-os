#!/bin/sh
# Augur commit-msg hook (cross-agent — fires for any committer).
# Enforces CLAUDE.md rule 28: dashboard UI/config commits must declare
# browser verification. Wraps require_browser_verify.py which inspects
# staged paths against the dashboard-affecting set and the commit
# message for a Verified-Browser: or Skip-Verify: trailer.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMIT_MSG_FILE="$1"

if [ ! -f "$REPO_ROOT/.github/scripts/require_browser_verify.py" ]; then
    # Older clones may not have this script yet — fail open with a notice
    # so commits don't silently break for collaborators on stale branches.
    echo "[commit-msg] require_browser_verify.py missing — skipping rule 28 check." >&2
    exit 0
fi

resolve_python() {
    for candidate in \
        "$REPO_ROOT/.venv/Scripts/python.exe" \
        "$REPO_ROOT/.venv/bin/python" \
        "$REPO_ROOT/.venv/bin/python3"
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    for candidate in python3 python
    do
        if command -v "$candidate" >/dev/null 2>&1; then
            resolved="$(command -v "$candidate")"
            case "$resolved" in
                *WindowsApps*python*)
                    continue
                    ;;
            esac
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

PYTHON="$(resolve_python)" || {
    echo "[commit-msg] Python not found; run uv sync to create .venv before committing." >&2
    exit 1
}

"$PYTHON" "$REPO_ROOT/.github/scripts/require_browser_verify.py" "$COMMIT_MSG_FILE"
