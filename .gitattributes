# Augur - Git Merge Strategy for User Data
# See ADR-048: Multi-User Scale Support
#
# User data files: always keep user's version during upstream merges.
# This prevents `git merge upstream/main` from overwriting user customizations.
# Users who want upstream data template changes must manually adopt them.

# User data YAML files — keep user's version on merge
data/core/**/*.yaml merge=ours
data/services/**/*.yaml merge=ours
data/apps/**/*.yaml merge=ours

# User data Markdown files — keep user's version on merge
data/core/**/*.md merge=ours
data/services/**/*.md merge=ours
data/apps/**/*.md merge=ours

# User memory — never overwritten by upstream
data/core/memory/** merge=ours

# Migration history — user-specific, never overwritten
data/core/runtime/migration_history.yaml merge=ours

# Auto-generated files — always take ours to avoid conflict markers
# These are regenerated by mount-plugins / generate_registry on every build,
# so the "ours" side is always correct after post-merge regeneration.
# Requires: git config merge.ours.driver true
config/dashboard/generated/assembled_hubs.json merge=ours
config/dashboard/generated/assembled_claude_plugins.json merge=ours
src/dashboard/lib/plugin-runtime/assembled-hubs.json merge=ours
src/lib/plugin-runtime/assembled-hubs.json merge=ours
skills/ai/augur/data/ide-integration/registry.yaml merge=ours

# ── Git LFS: Large binary files ──
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.node filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text

# ── Prevention: never commit these ──
node_modules/** -diff -merge -text
node_modules.bak*/** -diff -merge -text
